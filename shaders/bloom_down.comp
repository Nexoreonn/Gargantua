#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform sampler2D uSrc;
layout(rgba16f, binding = 0) uniform writeonly image2D uDst;
uniform float uThreshold;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(uDst);
    if (pixel.x >= dstSize.x || pixel.y >= dstSize.y) return;

    ivec2 srcSize = textureSize(uSrc, 0);
    vec2 uv = (vec2(pixel) + 0.5) / vec2(dstSize);
    vec2 texel = 1.0 / vec2(srcSize);
    vec3 color = vec3(0.0);
    color += texture(uSrc, uv + texel * vec2(-0.5, -0.5)).rgb;
    color += texture(uSrc, uv + texel * vec2( 0.5, -0.5)).rgb;
    color += texture(uSrc, uv + texel * vec2(-0.5,  0.5)).rgb;
    color += texture(uSrc, uv + texel * vec2( 0.5,  0.5)).rgb;
    color *= 0.25;

    float brightness = max(color.r, max(color.g, color.b));
    float contribution = max(brightness - uThreshold, 0.0) / max(brightness, 1e-5);
    imageStore(uDst, pixel, vec4(color * contribution, 1.0));
}
