{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "MSVC 2026 x64 (vcpkg)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs2026",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "vs2026-x64", "configuration": "Release" },
    { "name": "debug",   "configurePreset": "vs2026-x64", "configuration": "Debug" }
  ]
}
